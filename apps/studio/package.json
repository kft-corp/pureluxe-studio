{
  "name": "@pureluxe/studio",
  "version": "0.1.0",
  "description": "PureLuxe Studio — internal Next.js app for advisors, ops, and trip building.",
  "private": true,
  "scripts": {
    "dev": "node --require ./scripts/load-root-env.cjs ./node_modules/next/dist/bin/next dev --port 3002",
    "build": "node --require ./scripts/load-root-env.cjs ./node_modules/next/dist/bin/next build",
    "start": "node --require ./scripts/load-root-env.cjs ./node_modules/next/dist/bin/next start --port 3002",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.1",
    "@pureluxe/ai": "workspace:*",
    "@pureluxe/auth": "workspace:*",
    "@pureluxe/db": "workspace:*",
    "@pureluxe/rates": "workspace:*",
    "@pureluxe/shared": "workspace:*",
    "iron-session": "^8.0.4",
    "next": "16.3.3",
    "pdfkit": "^0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
