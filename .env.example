# Deploy target for this process
APP_NAME=studio

# Database (Supabase) — server only; see supabase/README.md
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Studio auth — fill in Phase 1 (see README Environment variables)
STUDIO_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev: http://localhost:3002/api/auth/callback (must match Google Cloud Console)
GOOGLE_REDIRECT_URI=

# AI — Trip Builder (Slice 1+)
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=

# Trip Builder agent (server only) — docs/trip-builder-agent-decisions.md §3
# Direct Postgres for the agent's saved progress. On Vercel use the Supabase
# Transaction pooler (port 6543). Without it, pilot advisors fall back to v1.
DATABASE_URL=
# Backup model when the main one is busy (Haiku class). Empty = no backup.
ANTHROPIC_FALLBACK_MODEL=

# Sabre hotels (Rate Layer Stage 1+) — CERT first; never commit real secrets
# docs/sabre/sabre-hotel-integration.md §8 / §12
SABRE_BASE_URL=https://api.cert.platform.sabre.com
SABRE_EPR_USER=
SABRE_EPR_PASS=
SABRE_PCC=
# Optional: GLOBAL (default), timeout ms
# SABRE_CODE_CONTEXT=GLOBAL
# SABRE_TIMEOUT_MS=30000
# Stage 5 open-GDS discover behind hotel_find (default ON when Sabre configured)
# SABRE_OPEN_GDS_BROWSE=1
# SABRE_OPEN_GDS_MIN_RATING=4
