# Deploy target for this process
APP_NAME=studio

# Database (Supabase) — server only; see supabase/README.md
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Studio auth — fill in Phase 1 (see README Environment variables)
STUDIO_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev: http://localhost:3002/api/auth/callback (must match Google Cloud Console)
GOOGLE_REDIRECT_URI=

# AI — Trip Builder (Slice 1+)
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=
